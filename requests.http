### 1. API health check
GET {{baseUrl}}/

### 2. Register a new user
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "REST Test User",
  "email": "rest-test-2026@example.com",
  "password": "TestPassword123"
}

### 3. Register with invalid data - should fail
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "",
  "email": "not-an-email",
  "password": "123"
}

### 4. Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "rest-test-2026@example.com",
  "password": "TestPassword123"
}

### 5. Get current user - requires JWT
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

### 6. Get current user without token - should fail
GET {{baseUrl}}/api/auth/me

### 7. Get all projects
GET {{baseUrl}}/api/projects
Authorization: Bearer {{token}}

### 8. Create project
POST {{baseUrl}}/api/projects
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "REST Client Test Project",
  "description": "Project created using requests.http",
  "owner": "{{userId}}"
}

### 9. Create project with invalid data - should fail
POST {{baseUrl}}/api/projects
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "",
  "description": "Invalid project",
  "owner": "wrong-id"
}

### 10. Get project by ID
GET {{baseUrl}}/api/projects/{{projectId}}
Authorization: Bearer {{token}}

### 11. Update project
PATCH {{baseUrl}}/api/projects/{{projectId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Updated REST Client Project"
}

### 12. Update nonexistent project - should fail
PATCH {{baseUrl}}/api/projects/507f1f77bcf86cd799439011
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Does not exist"
}

### 12a. Replace project (PUT) - all fields must be sent
PUT {{baseUrl}}/api/projects/{{projectId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Replaced REST Client Project",
  "description": "Full update using PUT"
}

### 12b. Replace project with a missing field - should fail (400)
PUT {{baseUrl}}/api/projects/{{projectId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Only the name is sent"
}

### 13. Delete project
DELETE {{baseUrl}}/api/projects/{{projectId}}
Authorization: Bearer {{token}}

### 14. Get all tasks
GET {{baseUrl}}/api/tasks
Authorization: Bearer {{token}}

### 15. Create task
POST {{baseUrl}}/api/tasks
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Test REST Client requests",
  "description": "Verify task creation",
  "status": "todo",
  "priority": "high",
  "project": "{{projectId}}"
}

### 16. Create task with invalid data - should fail
POST {{baseUrl}}/api/tasks
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "",
  "status": "invalid",
  "priority": "urgent",
  "project": "wrong-id"
}

### 17. Get task by ID
GET {{baseUrl}}/api/tasks/{{taskId}}
Authorization: Bearer {{token}}

### 18. Update task
PATCH {{baseUrl}}/api/tasks/{{taskId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Updated task title",
  "status": "in_progress"
}

### 19. Update nonexistent task - should fail
PATCH {{baseUrl}}/api/tasks/507f1f77bcf86cd799439011
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Does not exist"
}

### 19a. Replace task (PUT) - all fields must be sent, use null for "none"
PUT {{baseUrl}}/api/tasks/{{taskId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Replaced task title",
  "description": null,
  "status": "done",
  "priority": "low",
  "project": "{{projectId}}",
  "assignedTo": null,
  "dueDate": "2026-12-31T00:00:00.000Z"
}

### 19b. Replace task with missing fields - should fail (400)
PUT {{baseUrl}}/api/tasks/{{taskId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Only the title is sent"
}

### 20. Delete task
DELETE {{baseUrl}}/api/tasks/{{taskId}}
Authorization: Bearer {{token}}

### Part 2: search projects by name (case insensitive)
GET {{baseUrl}}/api/projects?search=rest
Authorization: Bearer {{token}}

### Part 2: create project without owner - owner is taken from the token
POST {{baseUrl}}/api/projects
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Project with owner from token"
}

### Part 2: create task with invalid priority - should fail Zod validation (400)
POST {{baseUrl}}/api/tasks
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Bad task",
  "project": "{{projectId}}",
  "priority": "urgent"
}
